{
  "name": "gladys-inexogy",
  "version": "0.1.2",
  "private": true,
  "description": "inexogy (formerly Discovergy) smart meters for Gladys Assistant through the official inexogy API: power, a guarded electricity index fed to the energy monitoring, tariffs, injection, phases, gas and water as sensors. Read-only.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-inexogy.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
